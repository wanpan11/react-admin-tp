{
  "name": "react-admin-tp",
  "type": "module",
  "version": "1.0.0",
  "description": "react-ts 后台管理系统项目模版内置菜单路由、状态管理多环境打包等工具开箱即用",
  "author": "wanpan11",
  "license": "ISC",
  "homepage": "https://wanpan11.github.io/react-admin-tp/",
  "keywords": [
    "react",
    "admin",
    "typescript"
  ],
  "main": "index.js",
  "scripts": {
    "start": "vite -c ./scripts/vite.config.ts",
    "build": "vite build -c ./scripts/vite.config.ts",
    "dev:build": "vite build -c ./scripts/vite.config.ts -m development --minify false",
    "lint": "eslint --fix && tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.4",
    "antd": "^5.15.3",
    "axios": "^1.6.8",
    "classnames": "^2.5.1",
    "nanoid": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "swr": "^2.3.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.15.0",
    "@eslint-react/eslint-plugin": "^1.52.2",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^18.19.24",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.18",
    "cross-env": "^7.0.3",
    "cssnano": "^6.1.0",
    "eslint": "^9.29.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "husky": "^8.0.3",
    "less": "^4.2.0",
    "lint-staged": "^13.3.0",
    "mockjs": "^1.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.2",
    "vite": "^4.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "bash -c tsc --noEmit"
    ]
  }
}
