{
  "name": "react-admin-tp",
  "type": "module",
  "version": "1.0.1",
  "description": "react-ts 后台管理系统项目模版内置菜单路由、状态管理多环境打包等工具开箱即用",
  "author": "wanpan11",
  "license": "ISC",
  "homepage": "https://wanpan11.github.io/react-admin-tp/",
  "keywords": [
    "react",
    "admin",
    "typescript"
  ],
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve -c ./scripts/webpack.config.cjs --mode development",
    "build": "cross-env NODE_ENV=production webpack -c ./scripts/webpack.config.cjs --mode production",
    "build:homepage": "cross-env NODE_ENV=homepage webpack -c ./scripts/webpack.config.cjs --mode production && node ./scripts/copyIndex2404.cjs",
    "dev:build": "cross-env NODE_ENV=development webpack -c ./scripts/webpack.config.cjs --mode development",
    "lint": "eslint --fix && tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
    "@ant-design/icons": "^6.1.0",
    "@babel/runtime": "^7.24.0",
    "@wanp/use-swr-data": "^1.2.0",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "core-js": "^3.36.0",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.22.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint-react/eslint-plugin": "^2.3.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@types/lodash": "^4.17.20",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.18",
    "babel-loader": "^8.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.10.0",
    "cssnano": "^7.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^8.0.3",
    "less": "^4.2.0",
    "less-loader": "^10.2.0",
    "lint-staged": "^13.3.0",
    "mini-css-extract-plugin": "^2.8.1",
    "mockjs": "^1.1.0",
    "postcss": "^8.4.36",
    "postcss-loader": "^7.3.4",
    "react-refresh": "^0.17.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "webpack": "^5.90.3",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
