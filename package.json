{
  "name": "react-admin-tp",
  "type": "module",
  "version": "1.0.1",
  "description": "react-ts 后台管理系统项目模版内置菜单路由、状态管理多环境打包等工具开箱即用",
  "author": "wanpan11",
  "license": "ISC",
  "homepage": "https://wanpan11.github.io/react-admin-tp/",
  "keywords": [
    "react",
    "admin",
    "typescript"
  ],
  "main": "index.js",
  "scripts": {
    "start": "cross-env rsbuild dev -c ./scripts/rsbuild.config.ts",
    "build": "cross-env rsbuild build -c ./scripts/rsbuild.config.ts",
    "dev:build": "cross-env NODE_ENV=development RSDOCTOR=true DEBUG=rsbuild rsbuild build -c ./scripts/rsbuild.config.ts -m development",
    "lint": "eslint --fix && tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.4",
    "@wanp/use-swr-data": "^1.0.3",
    "antd": "^5.15.3",
    "axios": "^1.6.8",
    "classnames": "^2.5.1",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "swr": "^2.3.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.15.0",
    "@eslint-react/eslint-plugin": "^1.52.2",
    "@rsbuild/core": "^1.2.19",
    "@rsbuild/plugin-less": "^1.1.1",
    "@rsbuild/plugin-react": "^1.1.1",
    "@rsdoctor/rspack-plugin": "^1.0.0",
    "@types/lodash": "^4.17.20",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^18.19.24",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "eslint": "^9.29.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "mockjs": "^1.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "bash -c tsc --noEmit"
    ]
  }
}
